# Postgres. Vercel Postgres or Neon both work; the driver expects an HTTP-capable URL.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Agenteki. Without this the analysis worker returns 503 and the rest still runs.
ANTHROPIC_API_KEY=""

# Market data.
# stub: deterministic fake data for development.
# yahoo-search: search-mediated Yahoo Finance evidence through WEB_SEARCH_PROVIDER.
MARKET_DATA_PROVIDER="stub"
MARKET_DATA_API_KEY=""

# Web search provider used by MARKET_DATA_PROVIDER="yahoo-search".
# Current implementation supports Brave Search API.
WEB_SEARCH_PROVIDER="none"
WEB_SEARCH_API_KEY=""

# Temporary write authorization for thesis/candidate mutation APIs.
# Required in production until full user/session auth is implemented.
MUTATION_API_KEY=""

# Vercel sends this as a bearer token on cron invocations.
# Without it, /api/cron/* is publicly callable. Required in production.
CRON_SECRET=""

AGENT_VERSION="agenteki-0.1.0"
