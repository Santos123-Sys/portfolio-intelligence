# Postgres. Vercel Postgres or Neon both work; the driver expects an HTTP-capable URL.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Agenteki. Without this the analysis worker returns 503 and the rest still runs.
ANTHROPIC_API_KEY=""

# Market data. ADR-005 is open — 'stub' produces deterministic fake data,
# clearly labelled as such, so the system is buildable before a vendor is chosen.
MARKET_DATA_PROVIDER="stub"
MARKET_DATA_API_KEY=""

# Vercel sends this as a bearer token on cron invocations.
# Without it, /api/cron/* is publicly callable. Required in production.
CRON_SECRET=""

AGENT_VERSION="agenteki-0.1.0"
