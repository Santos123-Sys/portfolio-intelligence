# Railway Postgres or any standard PostgreSQL database.
DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# Signs browser sessions. Generate at least 32 random bytes; never expose it to the browser.
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Separate 32+ character secret for AES-GCM encrypted authenticator seeds and
# recovery-code HMACs. Required before users can enable MFA.
MFA_ENCRYPTION_KEY="replace-with-a-different-32-character-secret"

# Canonical browser origin. Pins CSRF checks and must use HTTPS in production.
PUBLIC_APP_URL="https://portfolio.example.com"

# Market data.
# stub: deterministic fake data for development.
# yahoo-search: search-mediated Yahoo Finance evidence through WEB_SEARCH_PROVIDER.
# eodhd: authoritative validation, historical prices and fundamentals after a
# candidate passes human review. It is intentionally separate from discovery.
MARKET_DATA_PROVIDER="eodhd"
MARKET_DATA_API_KEY=""

# Cheap breadth-first discovery. Use Finnhub for the initial Swiss/Brazilian
# security universe. The same key supplies basic-financial fallbacks when the
# EODHD plan rejects its fundamentals endpoint; EODHD remains primary and
# continues to supply accepted-candidate prices.
DISCOVERY_PROVIDER="finnhub"
FINNHUB_API_KEY=""
# Optional fallback if Finnhub is unavailable. This consumes EODHD calls.
DISCOVERY_FALLBACK_PROVIDER="eodhd"
DISCOVERY_UNIVERSE_CACHE_HOURS="168"

# Provider gateway budgets — self-imposed, not a measurement of the vendor's
# real limit (see docs/MARKET-DATA.md#the-provider-gateway). All three have
# working defaults; uncomment only to override.
# MARKET_DATA_GATEWAY_CALLS_PER_MINUTE="60"
# MARKET_DATA_GATEWAY_CALLS_PER_DAY="2000"
# MARKET_DATA_GATEWAY_PLAN_LIMIT_MEMORY_HOURS="24"

# Qualitative thesis-fit research. Tavily is recommended; Brave remains supported.
WEB_SEARCH_PROVIDER="tavily"
WEB_SEARCH_API_KEY=""
# Set the same WEB_SEARCH_* values on agentic-worker. It is the Web Research
# Agent and calls Tavily/Brave after the 20–50-company structural screen.

# Railway Cron service bearer credential for /api/cron/refresh.
CRON_SECRET=""

# Private Railway URL for the integrated agentic API service.
# Example Railway reference:
# http://${{agentic-api.RAILWAY_PRIVATE_DOMAIN}}:${{agentic-api.PORT}}
AGENTIC_SYSTEM_BASE_URL="http://agentic-api.railway.internal:8080"

# Shared only by the dashboard server and agentic service. Use at least 32 random bytes.
AGENTIC_SYSTEM_API_KEY=""

# Used only by `npm run admin:create` and `npm run seed`; remove after provisioning.
INITIAL_ADMIN_EMAIL="owner@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-unique-passphrase-of-15-or-more-characters"
INITIAL_ADMIN_NAME="Portfolio Owner"

# Used only by the optional Railway Cron service. Configure the Railway service
# with: http://${{dashboard.RAILWAY_PRIVATE_DOMAIN}}:${{dashboard.PORT}}
DASHBOARD_INTERNAL_URL="http://dashboard.railway.internal:3000"

# -----------------------------------------------------------------------------
# Agentic API + worker services (use a separate Railway PostgreSQL service)
# -----------------------------------------------------------------------------
AGENTIC_DATABASE_URL="postgresql://user:pass@host:5432/agentic?sslmode=require"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6"
OPENAI_REASONING_EFFORT="medium"

# Optional per-stage overrides. Unset means "use OPENAI_REASONING_EFFORT".
# The four agents do not repay reasoning depth equally: extraction is close to
# transcription and is forbidden from inferring anything, while discovery and
# analysis carry the judgement. Raising those two without paying for it on
# extraction is what these exist for.
OPENAI_REASONING_EFFORT_EXTRACTION=""
OPENAI_REASONING_EFFORT_ANALYSIS=""
OPENAI_REASONING_EFFORT_SYNTHESIS=""
OPENAI_REASONING_EFFORT_DISCOVERY=""

# Dashboard callback and the API's private self-reference. On Railway, use:
# http://${{dashboard.RAILWAY_PRIVATE_DOMAIN}}:${{dashboard.PORT}}/api/integrations/agentic/import
DASHBOARD_IMPORT_URL="http://dashboard.railway.internal:3000/api/integrations/agentic/import"
# http://${{agentic-api.RAILWAY_PRIVATE_DOMAIN}}:${{agentic-api.PORT}}
AGENTIC_INTERNAL_BASE_URL="http://agentic-api.railway.internal:8080"

# Railway bucket variables can be referenced directly as BUCKET, ENDPOINT,
# REGION, ACCESS_KEY_ID and SECRET_ACCESS_KEY. AGENTIC_BUCKET_* aliases also work.
AGENTIC_BUCKET_NAME=""
AGENTIC_BUCKET_ENDPOINT=""
AGENTIC_BUCKET_REGION="auto"
AGENTIC_BUCKET_ACCESS_KEY_ID=""
AGENTIC_BUCKET_SECRET_ACCESS_KEY=""

AGENTIC_WORKER_POLL_MS="1000"
# The worker serves a liveness endpoint on PORT so a hang is caught, not just a
# crash. Idle budget is widened to five poll intervals; a running job is instead
# given the whole AGENTIC_JOB_LEASE_SECONDS before it counts as stalled.
AGENTIC_WORKER_HEALTH_IDLE_BUDGET_MS="60000"
AGENTIC_JOB_LEASE_SECONDS="300"
AGENTIC_CALLBACK_MAX_ATTEMPTS="8"
